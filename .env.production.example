VITE_SITE_URL=https://your-domain.com

# Leave empty when the frontend is served from the same domain as the backend.
VITE_API_BASE_URL=

VITE_CHATBOT_USE_N8N=false
VITE_CHATBOT_AI_ENABLED=false
VITE_N8N_CHATBOT_WEBHOOK_URL=
VITE_N8N_CHATBOT_EVENTS_WEBHOOK_URL=

# Backend runtime on Hostinger Node.js app
NODE_ENV=production
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
SETUP_SECRET=replace_with_a_long_random_setup_secret
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com
SERVE_FRONTEND=true
FRONTEND_DIST_PATH=../dist
PUBLIC_APP_URL=https://your-domain.com

# Hostinger MySQL / MariaDB
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=u000000000_velvetapp
DB_PASSWORD=replace_with_hostinger_mysql_password
DB_NAME=u000000000_velvet
DATABASE_URL=mysql://u000000000_velvetapp:replace_with_hostinger_mysql_password@localhost:3306/u000000000_velvet
DB_SSL=false

# Map provider abstraction. Do not expose provider keys in the frontend.
MAP_PROVIDER=seed
MAP_ROUTE_PROVIDER=fallback
MAP_COUNTRY_FILTER=in
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
OPENROUTESERVICE_API_KEY=
HOSTED_NOMINATIM_BASE_URL=
NOMINATIM_BASE_URL=
MAP_PROVIDER_USER_AGENT=VelvetPearl/1.0

# Generated PDFs and email delivery
GENERATED_DOCUMENTS_DIR=backend/storage/generated-documents
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Velvet Pearl <no-reply@your-domain.com>"
BUSINESS_NAME=Velvet Pearl
BUSINESS_PHONE=+917845039353
BUSINESS_EMAIL=velvetpearl2026@gmail.com
BUSINESS_WEBSITE=https://your-domain.com
BUSINESS_ADDRESS=

# WhatsApp Cloud API remains optional; admin document sharing also prepares wa.me links.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_NUMBER=
WHATSAPP_CUSTOMER_ACK_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_ACK_TEMPLATE_LANGUAGE=en_US
