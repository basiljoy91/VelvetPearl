NODE_ENV=development
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
SETUP_SECRET=replace_with_a_long_random_setup_secret
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
REQUEST_BODY_LIMIT=250kb

# Hostinger-compatible MySQL / MariaDB connection
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=velvetapp
DB_PASSWORD=replace_me
DB_NAME=velvet_pearl# Optional alternative to the DB_* variables above. Leave blank when using DB_*.
DATABASE_URL=
DB_SSL=false

# Serve the built frontend from Express in production.
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=../dist
PUBLIC_APP_URL=http://localhost:3000

# Map provider abstraction. Use seed/fallback locally without paid keys.
MAP_PROVIDER=seed
MAP_ROUTE_PROVIDER=fallback
MAP_COUNTRY_FILTER=in
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
OPENROUTESERVICE_API_KEY=
HOSTED_NOMINATIM_BASE_URL=
NOMINATIM_BASE_URL=
MAP_PROVIDER_USER_AGENT=VelvetPearl/1.0

# Generated documents
GENERATED_DOCUMENTS_DIR=backend/storage/generated-documents
BUSINESS_NAME=Velvet Pearl
BUSINESS_PHONE=+917845039353
BUSINESS_EMAIL=velvetpearl2026@gmail.com
BUSINESS_WEBSITE=http://localhost:3000
BUSINESS_ADDRESS=

# SMTP email for invoice and quotation PDFs
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Velvet Pearl <no-reply@localhost>"

# Optional WhatsApp Cloud API notifications
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_NUMBER=
WHATSAPP_CUSTOMER_ACK_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_ACK_TEMPLATE_LANGUAGE=en_US
