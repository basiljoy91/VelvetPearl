NODE_ENV=production
PORT=3000

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
SETUP_SECRET=replace_with_a_long_random_setup_secret

CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# Supabase / PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:replace_me@db.your-project-ref.supabase.co:5432/postgres
# Or use separate variables instead of DATABASE_URL.
# DB_HOST=db.your-project-ref.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=replace_me
# DB_NAME=postgres
DB_SSL=true

SERVE_FRONTEND=true
FRONTEND_DIST_PATH=../dist

REQUEST_BODY_LIMIT=250kb

# Optional WhatsApp Cloud API integration
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_NUMBER=
WHATSAPP_CUSTOMER_ACK_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_ACK_TEMPLATE_LANGUAGE=en_US
