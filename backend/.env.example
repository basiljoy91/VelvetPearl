PORT=5000
JWT_SECRET=replace-with-a-secure-random-secret
SETUP_SECRET=replace-with-a-private-admin-setup-secret
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/velvet_pearl
DB_SSL=false

# Optional alternative to DATABASE_URL if you want separate values instead.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=velvet_pearl
# DB_USER=postgres
# DB_PASSWORD=your-password
